GEMINI_API_KEY=
# Optional: leave empty and set your key in the web app at /settings after first launch.

DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated extra CORS origins. Any https://*.vercel.app is allowed by default in main.py.
# CORS_EXTRA_ORIGINS=

# Monitor + Action: GEMINI_FLASH_MODEL (default gemini-2.5-flash).
# Analyst + Briefing use GEMINI_PRO_MODEL; default is Flash (same as above) for Pro quota limits — set to gemini-2.5-pro when your key supports it.
# GEMINI_FLASH_MODEL=gemini-2.5-flash
# GEMINI_PRO_MODEL=gemini-2.5-flash
